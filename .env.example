# ---- target flow ---------------------------------------------------------
# Reference values are for a US carrier reset flow; adjust for yours.
TARGET_HOST=account.example.com
ADN_HOST=adn.example.com
TOKEN_PATH=/guest-auth/prd01/guest/v1/tokens
INIT_PATH=/eui/v1/fpsInitSession
SEND_PATH=/eui/v1/fpsSendOtp
VERIFY_PATH=/eui/v1/fpsVerifyOtp
CHANGE_PATH=/eui/v1/fpsChangePassword

LOGIN_ID=4042007239
CLIENT_ID=MYTMO
FLOW_INDICATOR=password_reset
SCOPE=TMO_ID_profile associated_lines token openid
REDIRECT_URI=https://www.example.com/signin

# ---- egress --------------------------------------------------------------
PROXY_HOST=p.webshare.io
PROXY_PORT=1080
PROXY_PASS=replace-me

# One sticky username per identity, comma separated. Each gets its own window.
IDENTITIES=user-gb-1,user-ca-2,user-de-3

# ---- scheduling ----------------------------------------------------------
SLOTS=4
PER_CYCLE=20
COOLDOWN=660
CONCURRENCY=3
PORT_BASE=9101
CHROME_PORT_BASE=9301

# ---- localisation of the signed digest -----------------------------------
SIGNED_HEADERS=accept-language;language-pref;body
ACCEPT_LANGUAGE=en
LANGUAGE_PREF=en
